PURSESTRING_TOKEN=change-me-agent-token
PURSESTRING_ADMIN_TOKEN=change-me-admin-token
# Public https address of this server; turns on OAuth sign-in for ChatGPT and claude.ai
PURSESTRING_PUBLIC_URL=
SLACK_WEBHOOK_URL=
# Slack app signing secret; adds Approve/Deny buttons (interactivity URL: <public url>/slack/actions)
SLACK_SIGNING_SECRET=
DISCORD_WEBHOOK_URL=
LITHIC_API_KEY=
LITHIC_WEBHOOK_SECRET=
# Lithic event subscription secret; merchant refunds arrive at <public url>/webhooks/lithic
LITHIC_EVENTS_SECRET=
# Your own endpoint for signed refund events, and the secret that signs them
REFUND_WEBHOOK_URL=
REFUND_WEBHOOK_SECRET=
# Privacy.com cards funded from your own bank account (real money, no sandbox)
PRIVACY_API_KEY=
# Airwallex Issuing cards (50+ countries; demo environment unless adapter.airwallex.environment: production)
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_CARDHOLDER_ID=
