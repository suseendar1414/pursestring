{
  "name": "pursestring",
  "version": "0.3.0",
  "mcpName": "io.github.suseendar1414/pursestring",
  "description": "PurseString is an open-source MCP server that gives AI agents spending guardrails: your rules, and a human when needed, are checked before a card is issued or money moves.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "bench": "tsx bench/attack-benchmark.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "payments",
    "governance",
    "virtual-cards",
    "lithic",
    "hitl"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "viem": "2.57.16"
  },
  "type": "module",
  "bin": {
    "pursestring": "dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suseendar1414/pursestring.git"
  },
  "homepage": "https://github.com/suseendar1414/pursestring#readme"
}
